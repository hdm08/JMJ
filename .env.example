NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Firebase Authentication email/password login.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
FIREBASE_ALLOWED_EMAILS=your-email@example.com

# Optional local/admin fallback. Generate with:
# npm run website:hash-admin -- "your long password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:...

# Generate at least 32 random bytes, for example:
# openssl rand -base64 32
SESSION_SECRET=replace-with-strong-session-secret
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

BUSINESS_NAME=Jay Mataji Jewels
DRIVE_ROOT_FOLDER_NAME=JMJ Digital Catalogue
MAX_UPLOAD_MB=250

# Website Google Drive OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/callback
